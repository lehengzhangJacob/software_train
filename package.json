{
  "name": "food-tracker",
  "version": "0.1.2",
  "private": true,
  "packageManager": "npm@11.6.2",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "verify": "npm run test:ai && npm run test:memory && npm run test:agent && npm run test:agent-trace && npm run test:recognition && npm run test:mcp && npm run test:ordering && npm run test:health && npm run test:meal-validation && npm run test:meal-ui && npm run test:access && npm run test:exercise-plan && npm run test:exercise-plan-ui && npm run test:article && npm run test:article-background && npm run lint && npm run typecheck && npm run build",
    "smoke": "node scripts/release-smoke.mjs",
    "test:ai": "tsx --test scripts/ai-settings.test.ts",
    "test:memory": "tsx --test scripts/memory-contract.test.ts",
    "test:agent": "tsx --test scripts/agent-contract.test.ts",
    "test:agent-trace": "tsx --test scripts/agent-trace-contract.test.ts scripts/agent-stream-contract.test.ts",
    "test:recognition": "tsx --test scripts/recognition-handoff.test.ts",
    "test:mcp": "tsx --test scripts/mcp-contract.test.ts",
    "test:health": "tsx --test scripts/health-contract.test.ts",
    "test:meal-validation": "tsx --test scripts/meal-validation-contract.test.ts",
    "test:meal-ui": "tsx --test scripts/meal-ui-contract.test.ts",
    "test:exercise-plan": "tsx --test scripts/exercise-plan-contract.test.ts",
    "test:exercise-plan-ui": "tsx --test scripts/exercise-plan-ui-contract.test.ts",
    "test:article": "tsx --test scripts/article-contract.test.ts",
    "test:article-background": "tsx --test scripts/article-background-contract.test.ts",
    "verify:memory-migration": "node scripts/verify-memory-migration.mjs",
    "verify:memory-api": "node scripts/verify-memory-api.mjs",
    "verify:agent-api": "node scripts/verify-agent-api.mjs",
    "verify:mcp-api": "node scripts/verify-mcp-api.mjs",
    "release:check": "npm run db:migrate:status && npm run verify:memory-migration && npm run verify && npm run verify:memory-api && npm run verify:agent-api && npm run verify:mcp-api && npm run smoke",
    "deploy": "node scripts/deploy.mjs",
    "android:cloud": "node scripts/android-cloud.mjs",
    "demo:seed": "node scripts/seed-cloud-demo.mjs",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:status": "prisma migrate status",
    "db:seed": "tsx prisma/seed.ts",
    "db:prepare": "node scripts/ensure-sqlite-database.mjs",
    "db:init": "npm run db:prepare && npm run db:migrate:deploy && npm run db:seed",
    "db:generate": "prisma generate",
    "postinstall": "prisma generate",
    "test:ordering": "tsx --test scripts/ordering-contract.test.ts",
    "test:access": "tsx --test scripts/auth-contract.test.ts",
    "verify:cloud-gate": "node scripts/verify-cloud-gate.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@capacitor/android": "^8.5.0",
    "@capacitor/camera": "^8.2.2",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@capgo/capacitor-health": "^8.10.2",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@prisma/client": "6.19.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.23.0",
    "next": "16.3.1",
    "next-themes": "^0.4.6",
    "prisma": "6.19.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-dropzone": "^15.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.0",
    "typescript": "^5"
  }
}
