DATABASE_URL="file:../database/food_tracker.db"
STEP_API_KEY=""
STEP_API_BASE_URL="https://api.stepfun.com/v1"
STEP_API_MODEL="step-3.7-flash"
# Optional environment fallback for the McDonald's China official MCP.
# The GUI stores the token locally in data/mcdonalds.json and takes precedence.
MCDONALDS_MCP_URL="https://mcp.mcd.cn"
MCDONALDS_MCP_TOKEN=""
# Account delivery (C-17): database-backed sessions protect the public instance.
# false keeps the local development compatibility fallback; cloud sets true.
AUTH_REQUIRED="false"
# Server-only bootstrap invite. It is hashed into invite_codes on first use and
# must never be committed or returned to the browser.
AUTH_BOOTSTRAP_INVITE_CODE=""
AUTH_BOOTSTRAP_INVITE_MAX_USES="20"
# Legacy shared passcode; ignored by middleware after C-17 and used only as a
# temporary bootstrap fallback when AUTH_BOOTSTRAP_INVITE_CODE is unset.
APP_ACCESS_TOKEN=""
# Cloud deploy pipeline (scripts/deploy.mjs) defaults; override as needed.
DEPLOY_HOST="8.148.206.131"
DEPLOY_USER="soft"
DEPLOY_APP_DIR="/home/soft/final/app"
DEPLOY_PORT="8000"
